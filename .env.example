# Railway injects DATABASE_URL automatically once you add a Postgres plugin
# to this project — you shouldn't need to set it by hand there.
DATABASE_URL=postgres://user:password@localhost:5432/andas_slate

# Needed for the "Check-In Notes" page (/notes.html) to generate notes.
# Get one from console.anthropic.com → Settings → API Keys.
ANTHROPIC_API_KEY=sk-ant-...

# Optional — override the model used for note generation. Leave unset to
# use the server's default; set this if the default ever 404s on your account.
# ANTHROPIC_MODEL=claude-sonnet-4-5

PORT=3000
